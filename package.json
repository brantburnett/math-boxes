{
  "name": "math-boxes",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "start:pwa": "ng build --configuration production && http-server --proxy http://localhost:8080? -p 8080 -c-1 -o math-boxes dist",
    "build": "ng build",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "deploy": "ng deploy --base-href=/math-boxes/ --name=\"brantburnett\" --email=bburnett@centeredgesoftware.com",
    "cypress:open": "concurrently \"npm run start\" \"cypress open\"",
    "cypress:run": "concurrently \"npm run start\" \"cypress run\""
  },
  "private": true,
  "jest": {
    "preset": "jest-preset-angular",
    "setupFilesAfterEnv": [
      "<rootDir>/src/setup-jest.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/cypress/"
    ]
  },
  "dependencies": {
    "@angular/animations": "^21.2.22",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.22",
    "@angular/compiler": "^21.2.22",
    "@angular/core": "^21.2.22",
    "@angular/forms": "^21.2.22",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.22",
    "@angular/router": "^21.2.22",
    "@angular/service-worker": "^21.2.22",
    "rxjs": "^7.8.1",
    "tslib": "~2.6.2",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.4.0",
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/schematics": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular/build": "^21.2.23",
    "@angular/cli": "^21.2.23",
    "@angular/compiler-cli": "^21.2.22",
    "@angular/language-service": "^21.2.22",
    "@cypress/schematic": "^2.5.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.16",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@typescript-eslint/utils": "^8.69.0",
    "angular-cli-ghpages": "^3.1.0",
    "concurrently": "^8.2.2",
    "cypress": "15.15.0",
    "eslint": "^10.9.1",
    "http-server": "^14.1.1",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jest-preset-angular": "^16.2.0",
    "jsdom": "^26.1.0",
    "ts-node": "~10.9.2",
    "typescript": "~5.9.3"
  }
}
